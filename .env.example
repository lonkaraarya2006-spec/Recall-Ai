# Cloud LLM (required for live cloud-generated answers; get key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Supabase cloud database (server-side only).
# Create tables/functions by running supabase/schema.sql in Supabase SQL Editor.
# Copy your project URL and a server-only Secret API key from Supabase settings.
# Never use a secret/service-role key in frontend code or commit the populated .env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy key-name compatibility if your project only has a service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=

# Local-first memory retrieval
DATABASE_PATH=backend/data/recall_ai.db
VECTOR_BACKEND=auto
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_RELEVANCE=0.18
TOP_K=5
MAX_UPLOAD_MB=12

# Set to false only when hosting the frontend separately and you know the origin.
ALLOW_CORS_ALL=true

# Honors additions: Cost Guard & Budget Controls
LLM_ENABLED=true
LLM_MAX_RPM=6
LLM_DAILY_BUDGET=120
LLM_MAX_OUTPUT_TOKENS=900
LLM_REQUEST_TIMEOUT=35.0

# Memory Intelligence & Verification
RECENCY_WEIGHT=0.15
VERIFY_THRESHOLD=0.65
PRIVACY_SHIELD_DEFAULT=true
