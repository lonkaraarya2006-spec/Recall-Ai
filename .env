GEMINI_API_KEY=AQ.Ab8RN6JPp08n7ExREgdJGW6AJISuLiAO9kbucO3v2rHuOdOvqA
GEMINI_MODEL=gemini-3.8-flash

# Optional Supabase cloud database (server-side only).
# Create tables/functions by running supabase/schema.sql in Supabase SQL Editor.
# Copy your project URL and a server-only Secret API key from Supabase settings.
# Never use a secret/service-role key in frontend code or commit the populated .env.
SUPABASE_URL=https://qnepeabbooubcetizpyl.supabase.co
SUPABASE_SECRET_KEY=sb_secret_Qflbmd_BY-aJHpKCVrTpAw_W1IQHhoh
# Legacy key-name compatibility if your project only has a service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=

# Local-first memory retrieval
DATABASE_PATH=backend/data/recall_ai.db
VECTOR_BACKEND=auto
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_RELEVANCE=0.18
TOP_K=5
MAX_UPLOAD_MB=12

# Set to false only when hosting the frontend separately and you know the origin.
ALLOW_CORS_ALL=true
